# runtime dependencies.
uv.lock
# the self-hosted relay's signing key (deploy/nostr-relay/compose.yaml writes it)
.env
# a relay invite is a bearer code: whoever holds the file can join
*.invite
# a self-hosted relay's event store and blobs
/deploy/nostr-relay/data/
